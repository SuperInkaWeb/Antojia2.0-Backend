generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CONSUMER
  RESTAURANT_OWNER
  DELIVERY
  ADMIN
  MARKETING_ADMIN
  TECH_ADMIN
  FINANCE_ADMIN
}

enum MarketingAdminInviteStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum MarketingRewardType {
  PROMOTION
  PURCHASE_REWARD
}

enum ReportAudience {
  RESTAURANT
  CONSUMER
  DELIVERY
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum OrderType {
  DELIVERY
  RESERVATION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum ProductType {
  DISH
  DRINK
  COMBO
}

enum RestaurantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MERCADOPAGO
  YAPE
  CASH_ON_DELIVERY
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
  SUSPENDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  ON_FOOT
}

model User {
  id        String   @id @default(uuid())
  auth0Id   String   @unique
  email     String   @unique
  name      String
  phone     String?
  avatarUrl String?
  role      Role     @default(CONSUMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant?
  orders          Order[]
  driverProfile   DeliveryDriver?
  consumerProfile ConsumerProfile?
  driverRatings   DriverRating[] @relation("DriverRatingConsumer")
  adminSessions   AdminSession[]
  reports         SupportReport[] @relation("ReportAuthor")
  answeredReports  SupportReport[] @relation("ReportAnswerer")
  marketingRewards MarketingReward[]

  @@index([role])
  @@map("users")
}

model SupportReport {
  id          String         @id @default(uuid())
  audience    ReportAudience
  category    String
  description String         @db.Text
  status      ReportStatus   @default(OPEN)
  response    String?        @db.Text
  answeredAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  authorId    String
  author      User           @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answeredById String?
  answeredBy  User?          @relation("ReportAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([audience, category, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@map("support_reports")
}

model AdminSession {
  id        String   @id @default(uuid())
  userId    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("admin_sessions")
}

model MarketingAdminInvite {
  id            String                     @id @default(uuid())
  email         String?                    @unique
  tokenHash     String?                    @unique
  tokenExpiresAt DateTime?
  status        MarketingAdminInviteStatus @default(PENDING)
  createdByEmail String
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([status])
  @@map("marketing_admin_invites")
}

model MarketingReward {
  id             String             @id @default(uuid())
  title          String
  description    String?            @db.Text
  type           MarketingRewardType
  code           String?            @unique
  discountPct    Int?
  discountAmount Float?
  rewardPoints   Int?
  minPurchase    Float              @default(0)
  usageLimit     Int?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean            @default(true)
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  createdBy      User               @relation(fields: [createdById], references: [id])

  @@index([type, isActive])
  @@index([startsAt, endsAt])
  @@map("marketing_rewards")
}

model TechAdminInvite {
  id            String   @id @default(uuid())
  email         String?  @unique
  tokenHash     String?  @unique
  tokenExpiresAt DateTime?
  status        MarketingAdminInviteStatus @default(PENDING)
  createdByEmail String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@map("tech_admin_invites")
}

model FinanceAdminInvite {
  id            String   @id @default(uuid())
  email         String?  @unique
  tokenHash     String?  @unique
  tokenExpiresAt DateTime?
  status        MarketingAdminInviteStatus @default(PENDING)
  createdByEmail String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@map("finance_admin_invites")
}

model Restaurant {
  id                   String           @id @default(uuid())
  name                 String
  ruc                  String           @unique
  description          String?          @db.Text
  category             String
  logoUrl              String?
  bannerUrl            String?
  address              String
  addressReference     String?
  district             String
  latitude             Float?
  longitude            Float?
  phone                String?
  openingHours         Json?
  status               RestaurantStatus @default(PENDING_VERIFICATION)
  isDeliveryEnabled    Boolean          @default(true)
  isReservationEnabled Boolean          @default(true)
  deliveryFee          Float            @default(0)
  minOrderAmount       Float?
  estimatedTime        Int?
  commissionRate       Float            @default(0.08)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Datos de abono del restaurante. El número completo se guarda cifrado.
  bankAccountNumberEncrypted String?
  bankAccountNumberMasked    String?

  // Campos heredados de la antigua integración OAuth por restaurante.
  // Ya no se usan; se conservan temporalmente para evitar borrar datos
  // existentes hasta ejecutar una migración controlada más adelante.
  mpConnected      Boolean   @default(false)
  mpUserId         String?
  mpAccessToken    String?   @db.Text
  mpRefreshToken   String?   @db.Text
  mpTokenExpiresAt DateTime?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  products   Product[]
  categories ProductCategory[]
  orders     Order[]
  payouts    RestaurantPayout[]
  withdrawals RestaurantWithdrawal[]

  @@index([status, createdAt])
  @@index([category])
  @@index([district])
  @@map("restaurants")
}

model ProductCategory {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([restaurantId])
  @@map("product_categories")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        ProductType @default(DISH)
  price       Float
  discountPct Int         @default(0)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @default(cuid())
  type           OrderType
  status         OrderStatus @default(PENDING)
  subtotal       Float
  discountAmount Float       @default(0)
  deliveryFee    Float       @default(0)
  total          Float
  notes          String?     @db.Text

  reservationDate DateTime?
  reservationTime String?
  partySize       Int?

  deliveryAddress   String?
  deliveryDistrict  String?
  deliveryPhone     String?
  deliveryNotes     String?   @db.Text
  deliveryLatitude  Float?
  deliveryLongitude Float?
  estimatedDelivery DateTime?
  driverAssignedAt  DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  deliveryCode      String?     @unique
  deliveryProofUrl  String?
  deliveryProofAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  items   OrderItem[]
  payment Payment?
  driverRating DriverRating?

  driverId String?
  driver   DeliveryDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  consumerProfileId String?
  consumerProfile   ConsumerProfile? @relation(fields: [consumerProfileId], references: [id], onDelete: SetNull)

  savedAddressId String?
  savedAddress   SavedAddress? @relation(fields: [savedAddressId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([status, type, driverId])
  @@index([driverId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  quantity  Int
  unitPrice Float
  discount  Int    @default(0)
  subtotal  Float

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  currency      String        @default("PEN")
  transactionId String?
  metadata      Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
  @@index([method])
  @@map("payments")
}

model PlatformSettings {
  id               String   @id @default("main")
  commissionPercent Int     @default(20)
  updatedAt        DateTime @updatedAt

  @@map("platform_settings")
}

model RestaurantPayout {
  id               String   @id @default(uuid())
  restaurantId     String
  grossAmount      Float
  commissionPercent Int
  commissionAmount Float
  netAmount        Float
  createdAt        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, createdAt])
  @@map("restaurant_payouts")
}

model RestaurantWithdrawal {
  id                       String   @id @default(uuid())
  restaurantId             String
  amount                   Float
  isTest                   Boolean  @default(false)
  status                   String   @default("PENDING")
  bankName                 String
  accountHolder            String
  destinationAccountMasked String
  bankDetailsEncrypted     String   @db.Text
  transferReference        String?
  createdAt                DateTime @default(now())
  paidAt                   DateTime?
  updatedAt                DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, status, createdAt])
  @@index([status, createdAt])
  @@map("restaurant_withdrawals")
}

model DeliveryDriver {
  id           String       @id @default(uuid())
  status       DriverStatus @default(OFFLINE)
  vehicleType  VehicleType  @default(MOTORCYCLE)
  licensePlate String?

  dni         String? @unique
  dniPhotoUrl String?

  licenseNumber   String?
  licensePhotoUrl String?

  vehiclePhotoUrl String?
  isVerified      Boolean @default(false)

  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt   DateTime?

  totalDeliveries Int   @default(0)
  totalEarnings   Float @default(0)
  rating          Float @default(0)
  ratingCount     Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Datos de abono del repartidor. El número completo se guarda cifrado.
  bankAccountNumberEncrypted String?
  bankAccountNumberMasked    String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders   Order[]
  earnings DriverEarning[]
  ratings  DriverRating[]

  @@index([status])
  @@index([isVerified])
  @@map("delivery_drivers")
}

model DriverEarning {
  id      String    @id @default(uuid())
  amount  Float
  isPaid  Boolean   @default(false)
  paidAt  DateTime?
  orderId String    @unique

  driverId String
  driver   DeliveryDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("driver_earnings")
}

model DriverRating {
  id        String   @id @default(uuid())
  score     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  // Una entrega solo puede calificarse una vez.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverId String
  driver   DeliveryDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  consumerId String
  consumer   User   @relation("DriverRatingConsumer", fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([consumerId])
  @@map("driver_ratings")
}

model ConsumerProfile {
  id               String   @id @default(uuid())
  favoriteCuisines String[]
  dietaryNotes     String?
  totalOrders      Int      @default(0)
  totalSpent       Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  addresses SavedAddress[]
  orders    Order[]

  @@map("consumer_profiles")
}

model SavedAddress {
  id        String  @id @default(uuid())
  label     String
  address   String
  district  String
  reference String?
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)

  profileId String
  profile   ConsumerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())

  @@map("saved_addresses")
}
